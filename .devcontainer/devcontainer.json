{
  "name": "Python Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      },
      "extensions": [
        "ms-python.python"
      ]
    },
    "postCreateCommand": "pip install -r requirements.txt"
  }
}