{
  "name": "GestionTeamSoccer Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:3.14",
  "customizations": {
    "vscode": {
      "settings": {
        // VS Code utilisera automatiquement le venv créé
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "git.autofetch": true,
        "git.autofetchPeriod": 300,
        "python.languageServer": "Pylance",
        "python.analysis.typeCheckingMode": "basic"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -r requirements.txt",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "RedFish Api + static App",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode"
}