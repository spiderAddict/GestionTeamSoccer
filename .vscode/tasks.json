{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: install (frontend)",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "cwd": "${workspaceFolder}/frontend",
      "presentation": {
        "echo": true,
        "reveal": "always"
      }
    },
    {
      "label": "pip: install (backend)",
      "type": "shell",
      "command": "pip",
      "args": ["install", "-r", "requirements.txt"],
      "cwd": "${workspaceFolder}/backend",
      "presentation": {
        "echo": true,
        "reveal": "always"
      }
    },
    {
      "label": "npm: dev (frontend)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always"
      }
    },
    {
      "label": "Flask: run (backend)",
      "type": "shell",
      "command": "python",
      "args": ["run.py"],
      "cwd": "${workspaceFolder}/backend",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always"
      }
    }
  ]
}
