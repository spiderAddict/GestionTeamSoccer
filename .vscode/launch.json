{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI Alembic",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [],
            "env": {
                "APP_ENV": "dev" 
            },
            "justMyCode": true,
            "serverReadyAction": {
                "pattern": "Uvicorn running on http://0.0.0.0:5000",
                "uriFormat": "http://localhost:5000",
                "action": "openExternally"
            }
        }
    ]
}